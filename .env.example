# Claude for the text chat
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-haiku-5-5

# Vapi (voice) - public key from dashboard.vapi.ai > API Keys
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key
# Optional overrides
# VAPI_MODEL=claude-haiku-5-5
# VAPI_VOICE_ID=Rohan
# PUBLIC_APP_URL=https://your-app.vercel.app   # where Vapi sends tool calls (auto-detected on Vercel)

# Google Calendar (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=finserve-calendar@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
